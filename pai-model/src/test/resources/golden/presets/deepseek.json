{
  "model" : "deepseek-chat",
  "stream" : true,
  "stream_options" : {
    "include_usage" : true
  },
  "max_tokens" : 1024,
  "temperature" : 0.2,
  "messages" : [ {
    "role" : "system",
    "content" : "You are a coding agent."
  }, {
    "role" : "user",
    "content" : "Summarize README.md"
  }, {
    "role" : "assistant",
    "content" : "Reading it.",
    "reasoning_content" : "I should read the file.",
    "tool_calls" : [ {
      "id" : "call_1",
      "type" : "function",
      "function" : {
        "name" : "read",
        "arguments" : "{\"path\":\"README.md\"}"
      }
    } ]
  }, {
    "role" : "tool",
    "tool_call_id" : "call_1",
    "content" : "1\t# pai-next"
  }, {
    "role" : "user",
    "content" : [ {
      "type" : "text",
      "text" : "And this?"
    }, {
      "type" : "text",
      "text" : "(image omitted: the model does not accept image input)"
    } ]
  } ],
  "tools" : [ {
    "type" : "function",
    "function" : {
      "name" : "read",
      "description" : "Read a file.",
      "parameters" : {
        "type" : "object",
        "properties" : {
          "path" : {
            "type" : "string"
          }
        },
        "required" : [ "path" ]
      }
    }
  } ],
  "top_p" : 0.9
}
