<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.pai</groupId>
    <artifactId>pai-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>pai-cli</artifactId>
  <name>pai-cli</name>
  <description>Thin assembly: extension loading, REPL, slash commands.</description>

  <dependencies>
    <dependency>
      <groupId>dev.pai</groupId>
      <artifactId>pai-core</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.pai</groupId>
      <artifactId>pai-tools</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.pai</groupId>
      <artifactId>pai-tui</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
    </dependency>
    <!-- approvals, task list and verification ship with pai: class path extensions, never imported by cli code -->
    <dependency>
      <groupId>dev.pai</groupId>
      <artifactId>pai-ext-hitl</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>dev.pai</groupId>
      <artifactId>pai-ext-tasks</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>dev.pai</groupId>
      <artifactId>pai-ext-verify</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- test scope only: ArchUnit sees the extensions; at runtime they are loaded from ~/.pai/extensions -->
    <dependency>
      <groupId>dev.pai</groupId>
      <artifactId>pai-ext-mcp</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>dev.pai</groupId>
      <artifactId>pai-ext-memory</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <finalName>pai-cli</finalName>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>dev.pai.cli.Main</mainClass>
                  <manifestEntries>
                    <!-- JLine's JNI terminal provider (JDK 22+ reads this; JDK 21 needs the command line flag) -->
                    <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                  </manifestEntries>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
