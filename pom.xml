<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.pai</groupId>
  <artifactId>pai-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>pai-next</name>
  <description>Java terminal coding agent with a minimal core and an extension SPI.</description>

  <modules>
    <module>pai-model</module>
    <module>pai-core</module>
    <module>pai-tools</module>
    <module>pai-tui</module>
    <module>pai-ext-mcp</module>
    <module>pai-cli</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- live = real provider calls; run with -DexcludedGroups= to include them -->
    <excludedGroups>live</excludedGroups>

    <jackson.version>2.17.2</jackson.version>
    <slf4j.version>2.0.16</slf4j.version>
    <junit.version>5.11.3</junit.version>
    <assertj.version>3.26.3</assertj.version>
    <archunit.version>1.3.0</archunit.version>
    <jline.version>4.0.0</jline.version>

    <compiler-plugin.version>3.13.0</compiler-plugin.version>
    <surefire.version>3.5.2</surefire.version>
    <enforcer.version>3.5.0</enforcer.version>
    <spotless.version>2.44.4</spotless.version>
    <pmd-plugin.version>3.13.0</pmd-plugin.version>
    <p3c-pmd.version>2.1.1</p3c-pmd.version>
    <jacoco.version>0.8.12</jacoco.version>
    <exec-plugin.version>3.5.0</exec-plugin.version>
    <jar-plugin.version>3.4.2</jar-plugin.version>
    <shade-plugin.version>3.6.0</shade-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-simple</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.pai</groupId>
        <artifactId>pai-model</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.pai</groupId>
        <artifactId>pai-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.pai</groupId>
        <artifactId>pai-tools</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.pai</groupId>
        <artifactId>pai-tui</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.pai</groupId>
        <artifactId>pai-ext-mcp</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.jline</groupId>
        <artifactId>jline</artifactId>
        <version>${jline.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${jar-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${shade-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${compiler-plugin.version}</version>
        <configuration>
          <release>21</release>
          <compilerArgs>
            <arg>-Xlint:all,-processing,-serial</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
        <configuration>
          <excludedGroups>${excludedGroups}</excludedGroups>
          <trimStackTrace>false</trimStackTrace>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${enforcer.version}</version>
        <executions>
          <execution>
            <id>enforce</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,)</version>
                </requireJavaVersion>
                <banDuplicatePomDependencyVersions/>
                <bannedDependencies>
                  <excludes>
                    <exclude>com.squareup.okhttp3</exclude>
                    <exclude>com.squareup.okhttp</exclude>
                    <exclude>org.projectlombok</exclude>
                    <exclude>com.google.guava</exclude>
                    <exclude>org.apache.commons:commons-lang3</exclude>
                    <exclude>org.springframework</exclude>
                    <exclude>org.springframework.*</exclude>
                    <exclude>io.projectreactor</exclude>
                    <exclude>io.projectreactor.*</exclude>
                    <!-- logging bindings: only slf4j-simple, only in pai-cli -->
                    <exclude>ch.qos.logback:logback-classic</exclude>
                    <exclude>org.apache.logging.log4j:log4j-core</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <eclipse>
              <version>4.32</version>
              <file>${maven.multiModuleProjectDirectory}/build/p3c-eclipse-codestyle.xml</file>
            </eclipse>
            <removeUnusedImports/>
            <importOrder>
              <order>java,javax,org,com,dev.pai,,\#</order>
            </importOrder>
            <licenseHeader>
              <content>/* pai-next — Apache-2.0 */</content>
            </licenseHeader>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>

      <!-- P3C-PMD: reporting only (PMD 6.15 cannot parse Java 21 syntax; see 01-code-style §1.2) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <version>${pmd-plugin.version}</version>
        <configuration>
          <rulesets>
            <ruleset>rulesets/java/ali-comment.xml</ruleset>
            <ruleset>rulesets/java/ali-concurrent.xml</ruleset>
            <ruleset>rulesets/java/ali-constant.xml</ruleset>
            <ruleset>rulesets/java/ali-exception.xml</ruleset>
            <ruleset>rulesets/java/ali-flowcontrol.xml</ruleset>
            <ruleset>rulesets/java/ali-naming.xml</ruleset>
            <ruleset>rulesets/java/ali-oop.xml</ruleset>
            <ruleset>rulesets/java/ali-orm.xml</ruleset>
            <ruleset>rulesets/java/ali-other.xml</ruleset>
            <ruleset>rulesets/java/ali-set.xml</ruleset>
          </rulesets>
          <printFailingErrors>true</printFailingErrors>
          <failOnViolation>false</failOnViolation>
          <minimumPriority>2</minimumPriority>
          <linkXRef>false</linkXRef>
          <skipPmdError>true</skipPmdError>
          <targetJdk>11</targetJdk>
          <typeResolution>false</typeResolution>
          <!-- files PMD 6 cannot parse (records, sealed types, pattern switches); regenerate when adding such files -->
          <excludes>
            <exclude>dev/pai/cli/CliOptions.java</exclude>
            <exclude>dev/pai/cli/ModelCatalog.java</exclude>
            <exclude>dev/pai/cli/ProviderSetup.java</exclude>
            <exclude>dev/pai/cli/Repl.java</exclude>
            <exclude>dev/pai/cli/RetryingProviderImpl.java</exclude>
            <exclude>dev/pai/core/compaction/CharsTokenEstimatorImpl.java</exclude>
            <exclude>dev/pai/core/compaction/CompactionPolicy.java</exclude>
            <exclude>dev/pai/core/compaction/ModelSummarizerImpl.java</exclude>
            <exclude>dev/pai/core/ext/CommandResult.java</exclude>
            <exclude>dev/pai/core/ext/ExtensionHost.java</exclude>
            <exclude>dev/pai/core/ext/ExtensionStatus.java</exclude>
            <exclude>dev/pai/core/loop/AgentLoop.java</exclude>
            <exclude>dev/pai/core/ext/SessionEvent.java</exclude>
            <exclude>dev/pai/core/internal/LoopSnapshot.java</exclude>
            <exclude>dev/pai/core/internal/SchemaCheck.java</exclude>
            <exclude>dev/pai/core/internal/ToolRunner.java</exclude>
            <exclude>dev/pai/core/loop/AgentConfig.java</exclude>
            <exclude>dev/pai/core/loop/AgentEvent.java</exclude>
            <exclude>dev/pai/core/loop/ToolDecision.java</exclude>
            <exclude>dev/pai/core/session/JsonlSessionStoreImpl.java</exclude>
            <exclude>dev/pai/core/session/SessionEntry.java</exclude>
            <exclude>dev/pai/core/session/SessionHeader.java</exclude>
            <exclude>dev/pai/core/session/SessionId.java</exclude>
            <exclude>dev/pai/core/session/SessionTree.java</exclude>
            <exclude>dev/pai/core/skill/Frontmatter.java</exclude>
            <exclude>dev/pai/core/skill/Skill.java</exclude>
            <exclude>dev/pai/core/tool/ToolResult.java</exclude>
            <exclude>dev/pai/tui/EventView.java</exclude>
            <exclude>dev/pai/tui/SessionTreeView.java</exclude>
            <exclude>dev/pai/tui/StatusLine.java</exclude>
            <exclude>dev/pai/tui/Symbols.java</exclude>
            <exclude>dev/pai/tui/ToolCallSummaries.java</exclude>
            <exclude>dev/pai/model/AssistantMessage.java</exclude>
            <exclude>dev/pai/model/ChatOptions.java</exclude>
            <exclude>dev/pai/model/ChatRequest.java</exclude>
            <exclude>dev/pai/model/ContentBlock.java</exclude>
            <exclude>dev/pai/model/FakeProviderImpl.java</exclude>
            <exclude>dev/pai/model/Json.java</exclude>
            <exclude>dev/pai/model/Message.java</exclude>
            <exclude>dev/pai/model/ModelRef.java</exclude>
            <exclude>dev/pai/model/StreamEvent.java</exclude>
            <exclude>dev/pai/model/SystemMessage.java</exclude>
            <exclude>dev/pai/model/ToolDefinition.java</exclude>
            <exclude>dev/pai/model/ToolResultMessage.java</exclude>
            <exclude>dev/pai/model/Usage.java</exclude>
            <exclude>dev/pai/model/UserMessage.java</exclude>
            <exclude>dev/pai/model/codec/anthropic/AnthropicMessagesCodec.java</exclude>
            <exclude>dev/pai/model/codec/anthropic/AnthropicStreamDecoder.java</exclude>
            <exclude>dev/pai/model/codec/openai/OpenAiCompletionsCodec.java</exclude>
            <exclude>dev/pai/model/codec/openai/OpenAiStreamDecoder.java</exclude>
            <exclude>dev/pai/model/http/OpenAiCompatProviderImpl.java</exclude>
            <exclude>dev/pai/model/http/SseClient.java</exclude>
            <exclude>dev/pai/model/http/StreamingCall.java</exclude>
            <exclude>dev/pai/ext/mcp/ClientInfo.java</exclude>
            <exclude>dev/pai/ext/mcp/InitializeResult.java</exclude>
            <exclude>dev/pai/ext/mcp/McpToolDescriptor.java</exclude>
            <exclude>dev/pai/ext/mcp/CallToolResult.java</exclude>
            <exclude>dev/pai/ext/mcp/McpResource.java</exclude>
            <exclude>dev/pai/ext/mcp/ReadResourceResult.java</exclude>
            <exclude>dev/pai/ext/mcp/JsonRpc.java</exclude>
            <exclude>dev/pai/ext/mcp/McpServerConfig.java</exclude>
            <exclude>dev/pai/ext/mcp/McpServerManager.java</exclude>
            <exclude>dev/pai/ext/mcp/McpClient.java</exclude>
            <exclude>dev/pai/ext/mcp/McpConfig.java</exclude>
            <exclude>dev/pai/ext/mcp/McpTool.java</exclude>
            <exclude>dev/pai/ext/mcp/McpCommand.java</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <id>p3c-report</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
        <dependencies>
          <dependency>
            <groupId>com.alibaba.p3c</groupId>
            <artifactId>p3c-pmd</artifactId>
            <version>${p3c-pmd.version}</version>
          </dependency>
        </dependencies>
      </plugin>

      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Line budgets + no TODO (02-governance §3); runs once from the root -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec-plugin.version}</version>
        <inherited>false</inherited>
        <executions>
          <execution>
            <id>check-budgets</id>
            <phase>verify</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>bash</executable>
              <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
              <arguments>
                <argument>build/check-budgets.sh</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
