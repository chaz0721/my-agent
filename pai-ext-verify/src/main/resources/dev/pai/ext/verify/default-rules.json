[
  {"marker": "pom.xml", "rules": [
    {"on": "write|edit", "pathGlob": "**/{*.java,pom.xml}", "run": "mvn -q compile", "timeoutSeconds": 180, "mode": "append"}]},
  {"marker": "package.json", "requiresScript": "typecheck", "rules": [
    {"on": "write|edit", "pathGlob": "**/{*.ts,*.tsx,*.mts,*.cts}", "run": "npm run -s typecheck",
     "timeoutSeconds": 180, "mode": "append"}]},
  {"marker": "Cargo.toml", "rules": [
    {"on": "write|edit", "pathGlob": "**/{*.rs,Cargo.toml}", "run": "cargo check", "timeoutSeconds": 180, "mode": "append"}]},
  {"marker": "go.mod", "rules": [
    {"on": "write|edit", "pathGlob": "**/{*.go,go.mod}", "run": "go build ./...", "timeoutSeconds": 180, "mode": "append"}]},
  {"markers": ["pyproject.toml", "setup.py", "setup.cfg", "requirements.txt"],
   "note": "-I keeps the working directory off sys.path: without it a compileall.py or py_compile.py the model wrote there would run. A project's own {python} -m rule needs -I as well. pycache_prefix keeps __pycache__ out of the tree; {tmp} is the JVM temp directory, expanded by pai (cmd does not expand ${TMPDIR}).",
   "rules": [
    {"on": "write|edit", "pathGlob": "**/*.py",
     "run": "{python} -I -X pycache_prefix={tmp}/pai-pycache -m compileall -q {path}",
     "allFiles": "-x '(^|[/\\\\])(\\.venv|venv|site-packages|node_modules|__pycache__|\\.git)([/\\\\]|$)' .",
     "timeoutSeconds": 30, "mode": "append"}]}
]
